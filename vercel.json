{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(js|css|pages|icons|)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/(manifest.json|sw.js|index.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}