// src/js/utils.js
export function showAlert(message, type = 'info') {
  const colors = { success: '#28a745', danger: '#dc3545', warning: '#ffc107', info: '#17a2b8' };
  const div = document.createElement('div');
  div.style.cssText = `position:fixed;top:20px;right:20px;z-index:9999;padding:15px 25px;border-radius:8px;color:white;font-weight:600;background:${colors[type]};box-shadow:0 4px 15px rgba(0,0,0,0.3);`;
  div.textContent = message;
  document.body.appendChild(div);
  setTimeout(() => div.remove(), 4000);
}

export function formatDate(timestamp) {
  if (!timestamp) return '-';
  const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);
  return date.toLocaleString('es-ES');
}

export function getCurrentLocation() {
  return new Promise((resolve, reject) => {
    if (!navigator.geolocation) return reject('Geolocalización no soportada');
    navigator.geolocation.getCurrentPosition(
      pos => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
      err => reject(err),
      { enableHighAccuracy: true, timeout: 10000 }
    );
  });
}

export async function calculateRouteCost(origen, destino, precios, personas = 1) {
  try {
    // Usar Nominatim para geocodificar (gratis)
    const [orig, dest] = await Promise.all([
      fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(origen)}`).then(r => r.json()),
      fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(destino)}`).then(r => r.json())
    ]);

    if (!orig.length || !dest.length) throw new Error('Direcciones no encontradas');

    const [oLat, oLng] = [parseFloat(orig[0].lat), parseFloat(orig[0].lon)];
    const [dLat, dLng] = [parseFloat(dest[0].lat), parseFloat(dest[0].lon)];

    // OSRM para ruta
    const route = await fetch(`https://router.project-osrm.org/route/v1/driving/${oLng},${oLat};${dLng},${dLat}?overview=false`).then(r => r.json());
    if (!route.routes?.length) throw new Error('No hay ruta');

    const distanceKm = route.routes[0].distance / 1000;
    const durationHours = route.routes[0].duration / 3600;

    const costo = (
      (distanceKm * (precios.porKm || 0)) +
      (durationHours * (precios.porHora || 0)) +
      (personas * (precios.porPersona || 0)) +
      (1 * (precios.porZona || 0))
    ).toFixed(2);

    return { costo: `$${costo}`, distance: `${distanceKm.toFixed(1)} km`, duration: `${durationHours.toFixed(1)} h`, distanceKm, durationHours };
  } catch (e) {
    console.error(e);
    throw new Error('Error calculando ruta: ' + e.message);
  }
}

export function exportToExcel(data, filename = 'historial.xlsx') {
  // Requiere SheetJS: <script src="https://cdn.sheetjs.com/xlsx-0.20.0/package/dist/xlsx.full.min.js"></script>
  if (typeof XLSX === 'undefined') { alert('Cargando librería Excel...'); return; }
  const ws = XLSX.utils.json_to_sheet(data);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Datos');
  XLSX.writeFile(wb, filename);
}